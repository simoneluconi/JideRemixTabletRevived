# Text files are stored with LF. Scripts that run in WSL, Linux or on the
# device keep LF in the working copy too; Windows batch files keep CRLF.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.rc text eol=lf
*.prop text eol=lf
*.mk text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
# Everything in the ramdisk runs on the tablet, extensionless scripts too
minirecovery/** text eol=lf
*.c text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
# git am needs the patches byte for byte
*.patch -text
